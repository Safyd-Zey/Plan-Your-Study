{
  "title": "Plan Your Study - Test Dashboard 📊",
  "tags": ["tests", "qa", "plan-your-study"],
  "timezone": "browser",
  "uid": "test-dashboard",
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-7d", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Passed Tests",
      "type": "stat",
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
      "targets": [{
        "datasource": {"type": "influxdb", "uid": "P951FEA4DE68E13C5"},
        "rawQuery": true,
        "query": "SELECT last(passed) FROM test_run",
        "refId": "A"
      }],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {"color": "red", "value": null},
            {"color": "yellow", "value": 15},
            {"color": "green", "value": 20}
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Failed Tests",
      "type": "stat",
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
      "targets": [{
        "datasource": {"type": "influxdb", "uid": "P951FEA4DE68E13C5"},
        "rawQuery": true,
        "query": "SELECT last(failed) FROM test_run",
        "refId": "A"
      }],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 1},
            {"color": "red", "value": 3}
          ]
        }
      }
    },
    {
      "id": 3,
      "title": "Code Coverage %",
      "type": "stat",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
      "targets": [{
        "datasource": {"type": "influxdb", "uid": "P951FEA4DE68E13C5"},
        "rawQuery": true,
        "query": "SELECT last(percentage) FROM coverage",
        "refId": "A"
      }],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "unit": "percent",
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {"color": "red", "value": null},
            {"color": "yellow", "value": 60},
            {"color": "green", "value": 80}
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "Total Tests Over Time",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{
        "datasource": {"type": "influxdb", "uid": "P951FEA4DE68E13C5"},
        "rawQuery": true,
        "query": "SELECT total FROM test_run",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "custom": {"showPoints": "auto", "lineWidth": 2},
          "color": {"mode": "palette-classic"}
        }
      }
    },
    {
      "id": 5,
      "title": "Test Summary",
      "type": "stat",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{
        "datasource": {"type": "influxdb", "uid": "P951FEA4DE68E13C5"},
        "rawQuery": true,
        "query": "SELECT last(total) FROM test_run",
        "refId": "A"
      }],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {"color": "blue", "value": null},
            {"color": "blue", "value": 0}
          ]
        }
      }
    },
    {
      "id": 6,
      "title": "Pass Rate Over Time (%)",

      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "targets": [{
        "datasource": {"type": "influxdb", "uid": "P951FEA4DE68E13C5"},
        "rawQuery": true,
        "query": "SELECT 100.0 * passed / total AS pass_rate FROM test_run WHERE total > 0",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {"showPoints": "auto", "lineWidth": 3},
          "color": {"mode": "palette-classic"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 80},
              {"color": "green", "value": 95}
            ]
          }
        }
      }
    }
  ,

    {
      "id": 20,
      "title": "⚡ Performance Testing",
      "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 24},
      "collapsed": false
    },

    {
      "id": 21,
      "title": "p95 Response Time (ms) by Scenario",
      "type": "bargauge",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 25},
      "targets": [{
        "datasource": {"type": "influxdb", "uid": "P951FEA4DE68E13C5"},
        "rawQuery": true,
        "query": "SELECT last(p95_ms) FROM perf_scenario GROUP BY \"scenario\"",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 200},
              {"color": "red", "value": 1000}
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "reduceOptions": {"calcs": ["last"]},
        "displayMode": "gradient",
        "showUnfilled": true
      }
    },

