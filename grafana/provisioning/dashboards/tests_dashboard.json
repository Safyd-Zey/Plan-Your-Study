    {
      "id": 24,
      "title": "Response Time Percentiles — All Scenarios",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 33},
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "P951FEA4DE68E13C5"},
          "rawQuery": true,
          "query": "SELECT last(median_ms) AS median_ms FROM perf_scenario GROUP BY \"scenario\"",
          "refId": "A"
        },
        {
          "datasource": {"type": "influxdb", "uid": "P951FEA4DE68E13C5"},
          "rawQuery": true,
          "query": "SELECT last(p95_ms) AS p95_ms FROM perf_scenario GROUP BY \"scenario\"",
          "refId": "B"
        },
        {
          "datasource": {"type": "influxdb", "uid": "P951FEA4DE68E13C5"},
          "rawQuery": true,
          "query": "SELECT last(p99_ms) AS p99_ms FROM perf_scenario GROUP BY \"scenario\"",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {"showPoints": "always", "pointSize": 8, "lineWidth": 2},
          "color": {"mode": "palette-classic"}
        }
      }
    },

